{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Standard Harness Doc Route V2.3/V2.4",
  "type": "object",
  "required": ["schemaVersion", "lane", "phase", "read", "do_not_read", "fallback", "budget"],
  "properties": {
    "schemaVersion": {
      "enum": [
        "standard-harness-v2.3-doc-route/v1",
        "standard-harness-v2.4-doc-route/v1"
      ]
    },
    "lane": { "type": "string" },
    "phase": { "type": "string" },
    "risk": { "type": "string" },
    "riskOverlays": { "type": "array", "items": { "type": "string" } },
    "profiles": { "type": "array", "items": { "type": "string" } },
    "changedFiles": { "type": "array", "items": { "type": "string" } },
    "read": { "type": "array", "items": { "type": "string" } },
    "do_not_read": { "type": "array", "items": { "type": "string" } },
    "fallback": { "type": "array", "items": { "type": "string" } },
    "budget": {
      "type": "object",
      "required": ["targetTokens", "maxDocuments"],
      "properties": {
        "targetTokens": { "type": "integer", "minimum": 0 },
        "maxDocuments": { "type": "integer", "minimum": 1 },
        "rawEvidencePolicy": { "type": "string" },
        "duplicateReadPolicy": { "type": "string" }
      }
    },
    "policy": { "type": "string" }
  }
}
