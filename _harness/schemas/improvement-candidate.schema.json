{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://standard-harness.local/schemas/improvement-candidate.schema.json",
  "title": "Standard Harness improvement candidate seed",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventType",
    "candidateId",
    "sourceXp",
    "sourceFrictionIds",
    "symptom",
    "rootCause",
    "candidateFix",
    "requiresHarnessPacket",
    "status"
  ],
  "properties": {
    "eventType": {"const": "improvement.candidate"},
    "candidateId": {"type": "string"},
    "sourceXp": {"type": "string", "pattern": "^XP-[0-9]{2}[A-Z]?$"},
    "sourceFrictionIds": {"type": "array", "items": {"type": "string"}},
    "symptom": {"type": "string"},
    "rootCause": {"type": "string"},
    "candidateFix": {
      "type": "object",
      "required": ["type", "description"],
      "properties": {
        "type": {"type": "string", "enum": ["schema", "policy", "validator", "gate", "docs", "manual", "starter"]},
        "description": {"type": "string"}
      }
    },
    "requiresHarnessPacket": {"type": "boolean"},
    "status": {"type": "string", "enum": ["proposed", "accepted", "rejected", "superseded"]}
  }
}
