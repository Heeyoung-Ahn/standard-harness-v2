{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Wiki Page",
  "type": "object",
  "required": [
    "entryType",
    "sourceTier",
    "provenance",
    "owner",
    "reviewStatus",
    "relatedHrIds",
    "relatedXpIds",
    "packetIds",
    "evidenceIds",
    "content"
  ],
  "properties": {
    "entryType": {"enum": ["DECISION", "ASSUMPTION", "DEPRECATED", "FRICTION", "IMPROVEMENT_CANDIDATE"]},
    "sourceTier": {"type": "string"},
    "provenance": {"type": "object"},
    "owner": {"type": "string"},
    "reviewStatus": {"type": "string"},
    "relatedHrIds": {"type": "array", "items": {"type": "string"}},
    "relatedXpIds": {"type": "array", "items": {"type": "string"}},
    "packetIds": {"type": "array", "items": {"type": "string"}},
    "evidenceIds": {"type": "array", "items": {"type": "string"}},
    "content": {"type": "string"}
  }
}
