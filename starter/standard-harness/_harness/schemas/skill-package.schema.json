{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "descriptorVersion",
    "packageId",
    "skillId",
    "trigger",
    "triggerKeywords",
    "taskTypes",
    "processPriority",
    "sourceAuthority",
    "sourceSet",
    "sourceDisposition",
    "runtimeSurfaces",
    "runtimeDependencyPolicy",
    "permissionScope",
    "authorityBoundary",
    "requiredNextPackageIds",
    "requiredEvidence",
    "hardGates",
    "fallbackBehavior",
    "validationHooks",
    "providerWorkerUseContract",
    "conductorUseContract",
    "inputSchema",
    "outputSchema",
    "ledgerPath",
    "authorityRef",
    "bodyLoaded"
  ],
  "properties": {
    "descriptorVersion": {"const": "skill-package.v1"},
    "packageId": {"type": "string"},
    "skillId": {"type": "string"},
    "v1SkillName": {"type": ["string", "null"]},
    "trigger": {"type": "string", "pattern": "^Use when"},
    "triggerKeywords": {"type": "array", "items": {"type": "string"}},
    "taskTypes": {"type": "array", "items": {"type": "string"}},
    "processPriority": {"type": "integer"},
    "sourceAuthority": {"type": "string"},
    "sourceSet": {"type": "object"},
    "sourceDisposition": {"type": "object"},
    "runtimeSurfaces": {
      "type": "array",
      "items": {"enum": ["codex_app", "claude_code_app", "codex_cli", "claude_code_cli"]},
      "minItems": 4,
      "maxItems": 4
    },
    "runtimeDependencyPolicy": {
      "type": "object",
      "required": ["requiresSuperpowersPlugin", "providerNeutral"],
      "properties": {
        "requiresSuperpowersPlugin": {"const": false},
        "providerNeutral": {"const": true}
      }
    },
    "permissionScope": {"type": "object"},
    "authorityBoundary": {"const": "packet_workflow_human"},
    "requiredNextPackageIds": {"type": "array", "items": {"type": "string"}},
    "requiredEvidence": {"type": "object"},
    "hardGates": {"type": "array", "items": {"type": "string"}},
    "fallbackBehavior": {"type": "string"},
    "validationHooks": {"type": "object"},
    "providerWorkerUseContract": {"type": "object"},
    "conductorUseContract": {"type": "object"},
    "inputSchema": {"type": "string"},
    "outputSchema": {"type": "string"},
    "ledgerPath": {"const": "_ops/evidence/skill-use-ledger.jsonl"},
    "authorityRef": {"type": "string", "not": {"pattern": "SKILL\\.md"}},
    "bodyLoaded": {"const": false},
    "bodyRef": {"type": ["string", "null"]}
  }
}
