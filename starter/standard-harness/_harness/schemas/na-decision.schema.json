{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "standard-harness-v2/na-decision.schema.json",
  "title": "Standard Harness v2 Rule-Based N/A Decision",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "packetId",
    "gate",
    "status",
    "allowedByRule",
    "rationale",
    "substituteChecks",
    "approvedBy",
    "cannotBeUsedWhen",
    "policyVersion",
    "gateProfileVersion"
  ],
  "properties": {
    "packetId": {
      "type": "string",
      "minLength": 1
    },
    "packetType": {
      "type": "string"
    },
    "gate": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "N/A_RECORDED"
    },
    "allowedByRule": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "substituteChecks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "approvedBy": {
      "type": "object",
      "required": [
        "role"
      ],
      "properties": {
        "role": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "cannotBeUsedWhen": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "policyVersion": {
      "const": "0.2.0"
    },
    "gateProfileVersion": {
      "type": "string"
    }
  }
}
